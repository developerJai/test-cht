upstream codes_pro {
server unix:/var/www/codes-pro/tmp/sockets/puma.sock fail_timeout=0;
}

server {
  listen 80;
  server_name codeswords.com www.codeswords.com *.codeswords.com;
  return 301 https://www.codeswords.com$request_uri;
}

server {
  listen 443 ssl;
  server_name codeswords.com;
  ssl_certificate /root/ssl/codeswords_chain.pem;
  ssl_certificate_key /root/ssl/codeswords.key;
  return 301 https://www.codeswords.com$request_uri;
}

server {
  listen 443 ssl;
  server_name www.codeswords.com;
  ssl_certificate /root/ssl/codeswords_chain.pem;
  ssl_certificate_key /root/ssl/codeswords.key;
  root /var/www/codes-pro/public;
  client_max_body_size 4M;
  add_header X-Frame-Options SAMEORIGIN;
  add_header X-Content-Type-Options nosniff;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

  location ~ ^/(assets|packs) { expires max; gzip_static on; add_header Cache-Control public; }
  location / { try_files $uri @app; }
  location @app {
      proxy_pass http://codes_pro;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
  }
}
