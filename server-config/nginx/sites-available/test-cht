upstream test_cht_puma {
  server unix:/var/www/test-cht/tmp/sockets/puma.sock fail_timeout=0;
}

server {
  listen 80;
  server_name med.qd.je;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  server_name med.qd.je;

  ssl_certificate /root/ssl/med_qd_je.pem;
  ssl_certificate_key /root/ssl/med_qd_je.key;

  root /var/www/test-cht/public;
  client_max_body_size 4M;

  location / {
    try_files $uri @app;
  }

  location @app {
    proxy_pass http://test_cht_puma;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
