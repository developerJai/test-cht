upstream staging_noralooks {
server unix:/var/www/backoffice-storefront-staging/tmp/sockets/puma.sock fail_timeout=0;
}

upstream docsgent {
server unix:/var/www/docsgent/tmp/sockets/puma.sock fail_timeout=0;
}

server {
  listen 3000;
  server_name 103.47.224.92;
  root /var/www/backoffice-storefront-staging/public;
  client_max_body_size 4M;
  add_header X-Frame-Options SAMEORIGIN;
  add_header X-Content-Type-Options nosniff;

  location ~ ^/(assets|packs) { expires max; gzip_static on; }
  location / { try_files $uri @app; }
  location @app {
      proxy_pass http://staging_noralooks;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
  }
}

