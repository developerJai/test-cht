<div class="bg-gray-50 min-h-screen">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

    <div class="mb-6 sm:flex sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">🖼️ Shared Images</h1>
        <p class="mt-1 text-sm text-gray-600">
          Every picture sent in a conversation, newest first. Tap a name to show it.
        </p>
      </div>
      <div class="mt-4 flex flex-wrap gap-2 sm:mt-0">
        <a href="<%= admin_cloudinary_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-white text-gray-800 border border-gray-300 text-sm font-semibold rounded-lg hover:bg-gray-50">
          ☁️ Storage
        </a>
        <a href="<%= admin_users_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700">👥 Users</a>
        <a href="<%= admin_message_timestamps_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-white text-gray-800 border border-gray-300 text-sm font-semibold rounded-lg hover:bg-gray-50">🕒 Timing</a>
        <a href="<%= dashboard_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-gray-600 text-white text-sm font-semibold rounded-lg hover:bg-gray-700">← Dashboard</a>
      </div>
    </div>

    <% if flash[:success] %>
      <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200"><%= flash[:success] %></div>
    <% end %>
    <% if flash[:error] %>
      <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200"><%= flash[:error] %></div>
    <% end %>
    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4">
      <%= form_with url: admin_images_path, method: :get, class: "flex flex-wrap items-center gap-2" do %>
        <label class="text-sm font-medium text-gray-700">Whose pictures?</label>
        <select name="user_id" class="rounded-lg border border-gray-300 p-2 text-sm min-w-[10rem]">
          <option value="">— everyone —</option>
          <% @users.each do |u| %>
            <option value="<%= u.id %>" <%= "selected" if @user_id.to_s == u.id.to_s %>><%= u.username %></option>
          <% end %>
        </select>
        <button type="submit" class="px-4 py-2 bg-gray-900 text-white text-sm font-semibold rounded-lg hover:bg-gray-700">Show</button>
        <span class="text-xs text-gray-500"><%= pluralize(@total, "picture") %></span>
      <% end %>
    </div>

    <% if @storage.present? && @storage[:total].positive? %>
      <div class="mb-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
        <p>
          Storage holds <strong><%= pluralize(@storage[:total], "file") %></strong> for this person
          that <strong>no message points at any more</strong> — usually because the conversation
          was cleared. This page can only show pictures still attached to a message.
        </p>
        <p class="mt-2 flex flex-wrap gap-2">
          <% @storage[:folders].each do |folder| %>
            <a href="<%= admin_cloudinary_path(path: folder[:prefix]) %>"
               class="inline-flex items-center gap-1 rounded-lg border border-amber-300 bg-white px-2.5 py-1.5 text-xs font-semibold hover:bg-amber-100">
              📁 <%= folder[:prefix] %> (<%= folder[:count] %>)
            </a>
          <% end %>
        </p>
      </div>
    <% end %>

    <% if @user_id.present? && (@storage.nil? || @storage[:total].zero?) %>
      <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 text-sm text-gray-600">
        Nothing in storage under this username either. Folders are named from the
        username <strong>at the time of upload</strong>, so if this account was ever
        renamed its older pictures sit under the old name.
        <a href="<%= admin_cloudinary_path %>" class="font-semibold text-blue-700 hover:underline">Browse every folder</a>.
      </div>
    <% end %>
    <% if @groups.empty? %>
      <div class="rounded-xl border border-gray-200 bg-white p-8 text-center text-sm text-gray-500">
        <% if @user_id.present? %>
          No pictures from this person are still attached to a conversation.
        <% else %>
          No pictures are attached to any conversation.
        <% end %>
      </div>
    <% end %>

    <% @groups.each do |user_id, messages| %>
      <div class="mb-4 rounded-xl border border-gray-200 bg-white overflow-hidden">
        <div class="flex items-center justify-between gap-3 px-4 py-3 border-b border-gray-200 bg-gray-50">
          <h2 class="font-semibold text-gray-900">
            <%= @usernames[user_id] || "unknown (id #{user_id})" %>
          </h2>
          <span class="text-xs text-gray-500"><%= pluralize(messages.size, "picture") %></span>
        </div>

        <ul class="divide-y divide-gray-100">
          <% messages.each do |msg| %>
            <% url  = msg.image.to_s %>
            <% name = begin
                        File.basename(URI.parse(url).path)
                      rescue StandardError
                        "image-#{msg.id}"
                      end %>
            <li class="px-4 py-3">
              <button type="button" data-lightbox-url="<%= url %>" data-lightbox-label="<%= name %>"
                      id="img-btn-<%= msg.id %>" aria-controls="img-<%= msg.id %>" aria-expanded="false"
                      class="w-full flex items-start gap-3 text-left group">
                <span class="flex-shrink-0">
                  <img src="<%= url.sub("/upload/", "/upload/w_160,h_160,c_fill,q_auto,f_auto/") %>"
                       loading="lazy" alt="<%= name %>"
                       class="h-16 w-16 rounded-lg object-cover bg-gray-100">
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-sm font-medium text-blue-700 group-hover:underline break-all"><%= name %></span>
                  <span class="block text-xs text-gray-500">
                    #<%= msg.id %> ·
                    <%= @usernames[msg.user_id] || msg.user_id %> → <%= @usernames[msg.recipient_id] || "—" %> ·
                    <%= msg.created_at.in_time_zone("Asia/Kolkata").strftime("%d %b %Y %H:%M") %> IST
                  </span>
                </span>
                <span class="flex-shrink-0 text-xs text-gray-400">tap to zoom</span>
              </button>

              <div class="mt-2 flex justify-end">
                <%= button_to admin_image_path(msg),
                      method: :delete,
                      params: { user_id: @user_id },
                      form_class: "inline-flex",
                      class: "inline-flex items-center gap-1.5 rounded-lg border border-red-300 px-2.5 py-1.5 text-xs font-semibold text-red-600 hover:bg-red-50",
                      form: { onsubmit: "return confirm('Delete this picture from the chat and from storage? This cannot be undone.')" } do %>
                  🗑️ Delete
                <% end %>
              </div>

            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

  </div>
</div>

<script>
  function toggleImage(id) {
    var panel = document.getElementById('img-' + id);
    var btn   = document.getElementById('img-btn-' + id);
    if (!panel) return;
    var open = panel.classList.toggle('hidden') === false;
    if (btn) {
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
      var label = btn.querySelector('span:last-child');
      if (label) label.textContent = open ? 'hide' : 'show';
    }
  }
</script>
