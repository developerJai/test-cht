<div class="bg-gray-50 min-h-screen">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-6 sm:py-8">

    <div class="mb-6 sm:flex sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">☁️ Cloudinary Folders</h1>
        <p class="mt-1 text-sm text-gray-600">
          The storage itself, read live through the Admin API — including files no chat points at any more.
        </p>
      </div>
      <div class="mt-4 flex flex-wrap gap-2 sm:mt-0">
        <a href="<%= admin_images_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-white text-gray-800 border border-gray-300 text-sm font-semibold rounded-lg hover:bg-gray-50">🖼️ In chats</a>
        <a href="<%= admin_users_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-blue-600 text-white text-sm font-semibold rounded-lg hover:bg-blue-700">👥 Users</a>
        <a href="<%= dashboard_path %>" class="inline-flex items-center justify-center px-4 py-2 bg-gray-600 text-white text-sm font-semibold rounded-lg hover:bg-gray-700">← Dashboard</a>
      </div>
    </div>

    <% if flash[:success] %>
      <div class="mb-4 rounded-lg bg-green-50 p-4 text-sm text-green-800 border border-green-200"><%= flash[:success] %></div>
    <% end %>
    <% if flash[:error] %>
      <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200"><%= flash[:error] %></div>
    <% end %>

    <% if @error.present? %>
      <div class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-800 border border-red-200">
        <p class="font-semibold">Cloudinary did not answer.</p>
        <p class="mt-1 font-mono text-xs break-all"><%= @error %></p>
      </div>
    <% end %>

    <!-- breadcrumbs -->
    <nav class="mb-4 flex flex-wrap items-center gap-1 text-sm">
      <a href="<%= admin_cloudinary_path %>" class="font-semibold <%= @path.blank? ? 'text-gray-900' : 'text-blue-700 hover:underline' %>">All folders</a>
      <% @crumbs.each_with_index do |crumb, i| %>
        <span class="text-gray-400">/</span>
        <% if i == @crumbs.size - 1 %>
          <span class="font-semibold text-gray-900"><%= crumb[:name] %></span>
        <% else %>
          <a href="<%= admin_cloudinary_path(path: crumb[:path]) %>" class="text-blue-700 hover:underline"><%= crumb[:name] %></a>
        <% end %>
      <% end %>
    </nav>

    <!-- folders -->
    <% if @folders.any? %>
      <div class="mb-4 grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% @folders.each do |folder| %>
          <a href="<%= admin_cloudinary_path(path: folder["path"]) %>"
             class="flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-3 py-3 min-h-[52px] hover:bg-gray-50">
            <span class="text-lg">📁</span>
            <span class="min-w-0 text-sm font-semibold text-gray-900 truncate"><%= folder["name"] %></span>
          </a>
        <% end %>
      </div>
    <% elsif @error.blank? && @path.present? %>
      <p class="mb-4 text-sm text-gray-500">No sub-folders here.</p>
    <% end %>

    <!-- files -->
    <div class="rounded-xl border border-gray-200 bg-white overflow-hidden">
      <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 border-b border-gray-200 bg-gray-50">
        <h2 class="font-semibold text-gray-900">
          <%= @path.present? ? "Files in #{@path}" : "Files at the top level" %>
        </h2>
        <span class="text-xs text-gray-500"><%= pluralize(@resources.size, "file") %></span>
      </div>

      <% if @resources.empty? %>
        <p class="p-6 text-sm text-gray-500">
          <%= @error.present? ? "Could not list files." : "No files here." %>
        </p>
      <% else %>
        <ul class="divide-y divide-gray-100">
          <% @resources.each_with_index do |res, idx| %>
            <% pid     = res["public_id"].to_s %>
            <% url     = res["secure_url"].to_s %>
            <% is_orphan = res["_orphan"] %>
            <li class="px-4 py-3">
              <div class="flex items-start gap-3">
                <button type="button" onclick="toggleCloudImage(<%= idx %>)"
                        id="cf-btn-<%= idx %>" aria-controls="cf-<%= idx %>" aria-expanded="false"
                        class="min-w-0 flex-1 flex items-start gap-3 text-left group">
                  <span class="flex-shrink-0 mt-0.5"><%= res["resource_type"] == "video" ? "🎞️" : "🖼️" %></span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-medium text-blue-700 group-hover:underline break-all"><%= pid %></span>
                    <span class="block text-xs text-gray-500">
                      <%= res["format"] %> ·
                      <%= number_to_human_size(res["bytes"].to_i) %> ·
                      <%= res["width"] %>×<%= res["height"] %> ·
                      <%= Time.parse(res["created_at"].to_s).in_time_zone("Asia/Kolkata").strftime("%d %b %Y %H:%M") rescue res["created_at"] %>
                    </span>
                    <% if is_orphan %>
                      <span class="mt-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-amber-100 text-amber-800">
                        not used by any chat
                      </span>
                    <% else %>
                      <span class="mt-1 inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-semibold bg-green-100 text-green-800">
                        still in a chat
                      </span>
                    <% end %>
                  </span>
                </button>

                <%= button_to admin_cloudinary_path,
                      method: :delete,
                      params: { public_id: pid, resource_type: res["resource_type"], path: @path },
                      form_class: "inline-flex flex-shrink-0",
                      title: "Delete from Cloudinary",
                      class: "h-10 w-10 flex items-center justify-center text-red-600 border border-red-300 rounded-lg hover:bg-red-50",
                      form: { onsubmit: "return confirm('Permanently delete #{j pid} from Cloudinary?#{is_orphan ? '' : ' A chat still shows this picture and it will break.'} This cannot be undone.')" } do %>
                  🗑️
                <% end %>
              </div>

              <div id="cf-<%= idx %>" class="hidden mt-3">
                <% if res["resource_type"] == "video" %>
                  <video src="<%= url %>" controls class="max-h-96 w-auto rounded-lg border border-gray-200"></video>
                <% else %>
                  <img src="<%= url %>" alt="<%= pid %>" loading="lazy" class="max-h-96 w-auto rounded-lg border border-gray-200">
                <% end %>
                <p class="mt-1">
                  <a href="<%= url %>" target="_blank" rel="noopener noreferrer" class="text-xs text-gray-500 underline">open full size</a>
                </p>
              </div>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>

    <div class="mt-4 rounded-xl border border-gray-200 bg-white p-4 text-xs text-gray-600">
      <p>
        Browsing uses the Admin API, which is capped per hour and does
        <strong>not</strong> spend your monthly credits. Showing a picture does use bandwidth.
      </p>
      <% if @rate_remaining %>
        <p class="mt-1">
          <span class="font-semibold"><%= @rate_remaining %></span> of
          <span class="font-semibold"><%= @rate_allowed %></span> calls left this hour
          <% if @rate_reset_at %>
            · resets <%= @rate_reset_at.in_time_zone("Asia/Kolkata").strftime("%-I:%M %p") %> IST
          <% end %>
          · this page costs about 3 calls.
        </p>
      <% end %>
      <p class="mt-1">The list stops at <%= Admin::CloudinaryController::MAX_RESOURCES %> files per type per folder.</p>
    </div>

  </div>
</div>

<script>
  function toggleCloudImage(idx) {
    var panel = document.getElementById('cf-' + idx);
    var btn   = document.getElementById('cf-btn-' + idx);
    if (!panel) return;
    var open = panel.classList.toggle('hidden') === false;
    if (btn) btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
</script>
