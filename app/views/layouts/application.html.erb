    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    <script>

      // Enable pusher logging - don't include this in production
      Pusher.logToConsole = true;

      var pusher = new Pusher('268265a228eff4a444d7', {
        cluster: 'ap2'
      });

      var channel = pusher.subscribe('my-channel-<%=@user&.id%>');
      channel.bind('my-event', function(data) {
        let indicator = document.getElementById("new-message-indicator")
        indicator.value = "true"
      });
    </script>
  </head>

  <body>

  <div class="bg-white">
    <input type="hidden" id="new-message-indicator" value="false">
