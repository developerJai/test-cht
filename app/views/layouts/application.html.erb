    <div class="relative isolate overflow-hidden bg-gray-100 py-24 sm:py-32 border-t border-gray-200">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl lg:mx-0">
