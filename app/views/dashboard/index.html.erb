<% if flash[:notice] || flash[:error] || flash[:success] %>
  <div id="flash-message" class="fixed top-4 left-1/2 transform -translate-x-1/2 z-50 w-11/12 max-w-md">
    <div class="<%= flash[:error] ? 'bg-red-500' : 'bg-green-500' %> text-white px-4 py-3 rounded-lg shadow-lg flex items-center justify-between">
      <span class="text-sm font-medium"><%= flash[:notice] || flash[:error] || flash[:success] %></span>
      <button onclick="document.getElementById('flash-message').remove()" class="ml-4 text-white hover:text-gray-200">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>
  <script>
    setTimeout(function() {
      var el = document.getElementById('flash-message');
      if (el) el.remove();
    }, 3000);
  </script>
<% end %>

<div data-controller="chats">
<% if @current_user.admin? %>
  <%# Admin control panel. Sits at the very top so the switcher is the first
      thing on screen instead of three screens below the cover copy.
      NOTE: the links MUST keep data-user-id and the .unseen-badge child -
      the Pusher handler in the layout finds them by exactly that. %>
  <div id="admin-panel" class="hidden bg-white border-b border-gray-200">
    <div class="mx-auto max-w-3xl px-4 py-4 sm:px-6">

      <div class="flex items-center justify-between gap-3 mb-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-gray-500">Conversations</h2>
        <a href="<%= logout_path %>" class="text-xs font-semibold text-gray-500 hover:text-gray-900">Sign out</a>
      </div>

      <% if @all_users.present? %>
        <div class="-mx-4 px-4 sm:-mx-6 sm:px-6 overflow-x-auto">
          <div class="flex gap-2 pb-1 w-max">
            <% @all_users.each do |user| %>
              <% unseen_count = @unseen_counts&.fetch(user.id, 0) || 0 %>
              <% active = @person&.id == user.id %>
              <%= link_to switch_user_path(selected_user_id: user.id),
                    data: { user_id: user.id },
                    class: "flex items-center gap-2 rounded-full pl-1.5 pr-3 py-1.5 min-h-[44px] whitespace-nowrap #{active ? 'bg-gray-900 text-white' : 'bg-white text-gray-900 border border-gray-200 hover:bg-gray-50'}" do %>
                <span class="flex-shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-xs font-bold <%= active ? 'bg-white/20 text-white' : 'bg-blue-100 text-blue-700' %>">
                  <%= user.username[0].upcase %>
                </span>
                <span class="text-sm font-semibold"><%= user.username %></span>
                <% if unseen_count > 0 %>
                  <span class="unseen-badge ml-2 inline-flex items-center justify-center px-2 py-0.5 text-xs font-bold text-white bg-red-500 rounded-full" data-count="<%= unseen_count %>">
                    <%= unseen_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
      <% else %>
        <p class="text-sm text-gray-500">No other users yet.</p>
      <% end %>

      <% if @person.present? %>
        <div class="mt-3 flex items-center justify-center gap-2 rounded-xl bg-gray-900 px-4 py-3 text-sm font-semibold text-white cursor-pointer hover:bg-gray-700"
             data-action="click->chats#openModal" id="good-link">
          💬 Open chat with <%= @person.username %>
        </div>
      <% else %>
        <p class="mt-3 rounded-xl bg-amber-50 border border-amber-200 px-3 py-2.5 text-xs text-amber-900">
          Pick someone above to open their conversation.
        </p>
      <% end %>

      <div class="mt-4 grid grid-cols-4 gap-2">
        <a href="<%= admin_users_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2.5 min-h-[56px] text-[11px] font-semibold text-gray-700 hover:bg-gray-50">
          <span class="text-base">👥</span> Users
        </a>
        <a href="<%= admin_message_timestamps_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2.5 min-h-[56px] text-[11px] font-semibold text-gray-700 hover:bg-gray-50">
          <span class="text-base">🕒</span> Timing
        </a>
        <a href="<%= admin_images_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2.5 min-h-[56px] text-[11px] font-semibold text-gray-700 hover:bg-gray-50">
          <span class="text-base">🖼️</span> Images
        </a>
        <a href="<%= admin_tools_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2.5 min-h-[56px] text-[11px] font-semibold text-gray-700 hover:bg-gray-50">
          <span class="text-base">🧹</span> Cleanup
        </a>
      </div>

    </div>
  </div>
<% end %>

<div class="bg-white">
  <div class="mx-auto max-w-7xl py-16 sm:px-6 sm:py-32 lg:px-8">
    <div class="relative isolate overflow-hidden bg-gray-100 px-6 pt-16 shadow-lg sm:rounded-3xl sm:px-16 md:pt-24 lg:flex lg:gap-x-20 lg:px-24 lg:pt-0 border border-gray-200">
      <div class="mx-auto max-w-md text-center lg:mx-0 lg:flex-auto lg:py-32 lg:text-left">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Welcome, <%=@current_user.username%><br>Medicine Information Dashboard</h2>
        <p class="mt-6 text-lg leading-8 text-gray-600">Access comprehensive medicine information, check interactions, and manage your pharmaceutical database queries.
        </p>
        
        
        <div class="mt-10 mb-10 flex items-center justify-center gap-x-6 gap-y-3 lg:justify-start flex-wrap">
          <a href="<%=logout_path%>" class="rounded-md bg-gray-900 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">Checkout</a>
          <% if @person.present? || !@current_user.admin? %>
            <div class="text-sm font-semibold leading-6 text-gray-900 cursor-pointer" data-action="click->chats#openModal" id="good-link">Support</div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<%=render partial: "chat"%>

<div class="bg-white py-16 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <dl class="grid grid-cols-1 gap-x-8 gap-y-16 text-center lg:grid-cols-3">
      <div class="mx-auto flex max-w-xs flex-col gap-y-4">
        <dt class="text-base leading-7 text-gray-600">Medicines in Database</dt>
        <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">50,000+</dd>
      </div>
      <div class="mx-auto flex max-w-xs flex-col gap-y-4" id="queries-link" data-action="click->chats#toggleAdmin">
        <dt class="text-base leading-7 text-gray-600">Daily Queries</dt>
        <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">100,000+</dd>
      </div>
      <div class="mx-auto flex max-w-xs flex-col gap-y-4">
        <dt class="text-base leading-7 text-gray-600">Active Users</dt>
        <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">15,000+</dd>
      </div>
    </dl>
  </div>

</div>

</div>
</div>