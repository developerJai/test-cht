<div data-controller="chats">
<div class="bg-white">
  <div class="mx-auto max-w-7xl py-16 sm:px-6 sm:py-32 lg:px-8">
    <div class="relative isolate overflow-hidden bg-gray-100 px-6 pt-16 shadow-lg sm:rounded-3xl sm:px-16 md:pt-24 lg:flex lg:gap-x-20 lg:px-24 lg:pt-0 border border-gray-200">
      <div class="mx-auto max-w-md text-center lg:mx-0 lg:flex-auto lg:py-32 lg:text-left">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Welcome, <%=@current_user.username%><br>Medicine Information Dashboard</h2>
        <p class="mt-6 text-lg leading-8 text-gray-600">Access comprehensive drug information, check interactions, and manage your pharmaceutical database queries.
        </p>
        
        <% if @current_user.admin? && @all_users.present? %>
        <div class="mt-6">
          <div class="flex flex-wrap gap-2">
            <% @all_users.each do |user| %>
              <% unseen_count = @unseen_counts&.fetch(user.id, 0) || 0 %>
              <%= link_to switch_user_path(selected_user_id: user.id), 
                  data: { user_id: user.id },
                  class: "inline-flex items-center px-3 py-2 text-sm font-semibold rounded-md #{@person&.id == user.id ? 'bg-gray-800 text-white' : 'bg-white text-gray-900 border border-gray-300 hover:bg-gray-50'} shadow-sm relative" do %>
                <%= user.username %>
                <% if unseen_count > 0 %>
                  <span class="unseen-badge ml-2 inline-flex items-center justify-center px-2 py-0.5 text-xs font-bold text-white bg-red-500 rounded-full" data-count="<%= unseen_count %>">
                    <%= unseen_count %>
                  </span>
                <% end %>
              <% end %>
            <% end %>
          </div>
        </div>
        <% end %>
        
        <div class="mt-10 flex items-center justify-center gap-x-6 lg:justify-start flex-wrap">
          <% if @current_user.admin? %>
            <a href="<%=admin_users_path%>" class="rounded-md bg-white px-3.5 py-2.5 text-sm font-semibold text-black border border-gray-300 shadow-sm hover:bg-gray-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2">
              👥 Users
            </a>
          <% end %>
          <a href="<%=logout_path%>" class="rounded-md bg-gray-900 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-900">Checkout</a>
          <% if @person.present? || !@current_user.admin? %>
            <div class="text-sm font-semibold leading-6 text-gray-900 cursor-pointer" data-action="click->chats#openModal" id="good-link">Support</div>
          <% end %>
        </div>
      </div>
      <div class="relative mt-16 h-80 lg:mt-8 flex items-center justify-center">
        <div class="text-center">
          <div class="text-6xl font-bold text-gray-300">Rx</div>
          <p class="mt-4 text-sm text-gray-500">Medical Database</p>
        </div>
      </div>
    </div>
  </div>
</div>

<%=render partial: "chat"%>

<div class="bg-white py-16 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <dl class="grid grid-cols-1 gap-x-8 gap-y-16 text-center lg:grid-cols-3">
      <div class="mx-auto flex max-w-xs flex-col gap-y-4">
        <dt class="text-base leading-7 text-gray-600">Drugs in Database</dt>
        <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">50,000+</dd>
      </div>
      <div class="mx-auto flex max-w-xs flex-col gap-y-4">
        <dt class="text-base leading-7 text-gray-600">Daily Queries</dt>
        <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">100,000+</dd>
      </div>
      <div class="mx-auto flex max-w-xs flex-col gap-y-4" data-action="click->chats#openRemoved">
        <dt class="text-base leading-7 text-gray-600">Active Users</dt>
        <dd class="order-first text-3xl font-semibold tracking-tight text-gray-900 sm:text-5xl">15,000+</dd>
      </div>
    </dl>
  </div>

  <div id="removed-text" class="mx-auto max-w-7xl px-6 lg:px-8 bg-white text-left text-gray-300 hidden">
  <% if @current_user.username == "qwert" %>
    Gone ME <a href="<%=text_removed_clear_path()%>">Remove all</a>: <br>
      <% if @my_removed_texts.present? %>
        <% @my_removed_texts.each_with_index do |text,ind| %>
          <%=ind+1%> : <%=text.content.force_encoding('UTF-8')%> (<%= time_ago_in_words(text.created_at) %>)<br>
        <%end%>
      <% else %>
        N/A
      <% end %>
    <br><br>

    Gone Guest <a href="<%=text_removed_clear_path(guest: "yes")%>">Remove all</a>: <br>
    <% if @removed_texts.present? %>
      <% @removed_texts.each_with_index do |text,ind| %>
        <%=ind+1%> : <%=text.content.force_encoding('UTF-8')%> (<%= time_ago_in_words(text.created_at) %>)<br>
      <%end%>
    <% else %>
      N/A
    <% end %>
    <br><br>
    Clear: <br>

    <%=form_for :remove_msg, url: remove_msg_path do |f|%>
      <div class="flex">
        <input type="text" required autocomplete="off" name="from" placeholder="From" class="flex-shrink-0 z-10 inline-flex items-center py-2.5 px-4 text-sm font-medium text-center text-gray-900 bg-gray-100 border border-e-0 border-gray-300 dark:border-gray-700 dark:text-white rounded-s-lg hover:bg-gray-200 focus:ring-4 focus:outline-none focus:ring-gray-300 dark:bg-gray-600 dark:hover:bg-gray-700 dark:focus:ring-gray-800">

        <div class="relative w-full">
          <input type="text" required name="to" placeholder="To" class="block p-2.5 w-full z-20 text-sm text-gray-900 bg-gray-50 rounded-e-lg rounded-s-gray-100 rounded-s-2 border border-gray-300 focus:ring-blue-500 focus:border-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:border-blue-500">

          <input type="submit" value="Go" class="absolute top-0 end-0 p-2.5 h-full text-sm font-medium text-white bg-blue-700 rounded-e-lg border border-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">
        </div>
      </div>
    <% end %>

  <% end %>
</div>
</div>

</div>
</div>