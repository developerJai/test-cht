<div class="hidden" id="chat-modal">
  <div class="inset-0 transition-opacity" aria-hidden="true"></div>

  <div class="inset-0 z-10 w-screen overflow-y-auto">

    <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
      <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-3xl lg:max-w-5xl">
        <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
          <% if @current_user.admin? %>
            <div class="-mx-4 px-4 sm:-mx-6 sm:px-6 mb-3 grid grid-cols-4 gap-2">
              <a href="<%= admin_users_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2 min-h-[52px] text-[11px] font-semibold text-gray-700">
                <span class="text-base">👥</span> Users
              </a>
              <a href="<%= admin_message_timestamps_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2 min-h-[52px] text-[11px] font-semibold text-gray-700">
                <span class="text-base">🕒</span> Timing
              </a>
              <a href="<%= admin_images_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2 min-h-[52px] text-[11px] font-semibold text-gray-700">
                <span class="text-base">🖼️</span> Images
              </a>
              <a href="<%= admin_tools_path %>" class="flex flex-col items-center justify-center gap-1 rounded-xl border border-gray-200 py-2 min-h-[52px] text-[11px] font-semibold text-gray-700">
                <span class="text-base">🧹</span> Cleanup
              </a>
            </div>
          <% end %>
          <% if @current_user.admin? && @all_users.present? %>
            <div class="-mx-4 px-4 sm:-mx-6 sm:px-6 mb-3 pb-3 border-b border-gray-200 overflow-x-auto">
              <div class="flex gap-2 w-max">
                <% @all_users.each do |user| %>
                  <% unseen_count = @unseen_counts&.fetch(user.id, 0) || 0 %>
                  <% active = @person&.id == user.id %>
                  <%= link_to switch_user_path(selected_user_id: user.id),
                        data: { user_id: user.id, action: "click->chats#switchUser" },
                        class: "flex items-center gap-2 rounded-full pl-1.5 pr-3 py-1.5 min-h-[44px] whitespace-nowrap #{active ? 'bg-gray-900 text-white' : 'bg-white text-gray-900 border border-gray-200 [@media(hover:hover)]:hover:bg-gray-50'}" do %>
                    <span class="flex-shrink-0 h-8 w-8 rounded-full flex items-center justify-center text-xs font-bold <%= active ? 'bg-white/20 text-white' : 'bg-blue-100 text-blue-700' %>">
                      <%= user.username[0].upcase %>
                    </span>
                    <span class="text-sm font-semibold"><%= user.username %></span>
                    <% if unseen_count > 0 %>
                      <span class="unseen-badge ml-2 inline-flex items-center justify-center px-2 py-0.5 text-xs font-bold text-white bg-red-500 rounded-full" data-count="<%= unseen_count %>">
                        <%= unseen_count %>
                      </span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </div>
            <% unless @person.present? %>
              <p class="mb-3 rounded-lg bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-900">
                Pick someone above to open their conversation.
              </p>
            <% end %>
          <% end %>
          <%= form_with url: upload_img_path, method: :post, multipart: true,
                        id: "upload-form", data: { turbo: false,
                                                   max_image: DashboardController::MAX_IMAGE_BYTES,
                                                   max_video: DashboardController::MAX_VIDEO_BYTES } do %>
            <input id="file-input" name="image" class="hidden" type="file"
                   accept="image/*,video/*" data-action="change->chats#filePreview">

            <%# nothing chosen yet: one obvious button %>
            <label for="file-input" id="attach-button"
                   class="inline-flex items-center gap-2 rounded-full border border-gray-300 px-3 py-2 min-h-[44px] text-sm font-semibold text-gray-700 cursor-pointer hover:bg-gray-50">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"></path>
              </svg>
              Photo or video
            </label>

            <%# chosen: show what it is, how big, and let it be removed %>
            <div id="attach-card" class="hidden rounded-xl border border-gray-200 bg-gray-50 p-2">
              <div class="flex items-center gap-3">
                <div class="flex-shrink-0 h-14 w-14 rounded-lg bg-gray-200 overflow-hidden flex items-center justify-center">
                  <img id="selected-image" class="hidden h-full w-full object-cover" alt="">
                  <video id="selected-video" class="hidden h-full w-full object-cover" muted playsinline></video>
                  <span id="attach-icon" class="hidden text-xl">📄</span>
                </div>
                <div class="min-w-0 flex-1">
                  <p id="attach-name" class="truncate text-sm font-medium text-gray-900"></p>
                  <p id="attach-meta" class="text-xs text-gray-500"></p>
                </div>
                <button type="button" id="attach-remove" title="Remove" aria-label="Remove"
                        class="flex-shrink-0 h-10 w-10 flex items-center justify-center rounded-full text-gray-500 hover:bg-gray-200"
                        data-action="click->chats#clearImg">✕</button>
                <button type="submit" id="submit-image-btn"
                        class="flex-shrink-0 h-10 px-4 rounded-full bg-gray-900 text-sm font-semibold text-white hover:bg-gray-700"
                        data-action="click->chats#sendImage">Send</button>
              </div>

              <div id="upload-progress" class="hidden mt-2">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-gray-200">
                  <div id="upload-bar" class="h-full w-0 rounded-full bg-emerald-600 transition-[width] duration-150"></div>
                </div>
                <p id="upload-status" class="mt-1 text-xs text-gray-500">Sending…</p>
              </div>

              <p id="upload-error" class="hidden mt-2 rounded-lg bg-red-50 border border-red-200 px-2.5 py-1.5 text-xs text-red-800"></p>
            </div>
          <% end %>

          <div class="sm:flex sm:items-start">
            <div class="relative mx-auto grid w-full max-w-2xl grid-cols-1 gap-x-8 gap-y-4 lg:max-w-none">
              <div id="switch-loader" class="hidden absolute inset-0 z-20 flex items-center justify-center rounded-lg bg-white/75">
                <span class="flex items-center gap-2 rounded-full border border-gray-200 bg-white px-3 py-2 shadow-sm">
                  <span class="h-4 w-4 rounded-full border-2 border-gray-300 border-t-gray-700 animate-spin"></span>
                  <span class="text-xs text-gray-600">Loading <span id="switch-loader-name">conversation</span>…</span>
                </span>
              </div>
              <div class="mt-1 flex w-full max-w-md lg:max-w-none gap-x-4" data-controller="textbox">
                <textarea id="text-message" required="true" name="message" autocomplete="off" rows="2" class="min-w-0 flex-auto rounded-md border-0 bg-white px-3.5 py-2 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-inset focus:ring-gray-500 sm:text-sm sm:leading-6" data-action="keyup->textbox#checkKey input->textbox#updateText"></textarea>

                <button type="submit" class="flex-none rounded-md bg-gray-700 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-700" id="send-message" data-action="click->chats#sendMessage"><span aria-hidden="true">→</span></button>

                <button class="hidden flex-none rounded-md bg-gray-200 px-3.5 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-gray-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-200" id="sending-message"><span aria-hidden="true">...</span></button>
              </div>

              <div id="edit-banner" class="hidden flex items-center gap-2 rounded-lg bg-amber-50 border border-amber-200 px-2.5 py-1.5 text-xs text-amber-900">
                <span class="flex-shrink-0 font-semibold">Editing:</span>
                <span id="edit-banner-text" class="min-w-0 flex-1 truncate"></span>
                <button type="button" class="flex-shrink-0 font-semibold hover:underline" data-action="click->chats#cancelEdit">Cancel</button>
              </div>
              <span id="reply-msg-box" class="flex items-center px-2 py-1 me-2 text-sm font-medium text-gray-800 bg-gray-100 rounded dark:bg-gray-700 dark:text-gray-300 hidden">
                <input type="hidden" id="reply-to-id">
                <div id="reply-to"></div>
                <button type="button" class="inline-flex items-center p-1 ms-2 text-sm text-gray-400 bg-transparent rounded-sm hover:bg-gray-200 hover:text-gray-900 dark:hover:bg-gray-600 dark:hover:text-gray-300 float-right" id="remove-reply" data-action="click->chats#removeReply">
                  <svg class="w-2 h-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                  </svg>
                  <span class="sr-only">X</span>
                </button>
              </span>
              
              <%= turbo_frame_tag "messages_list" do %>
                <% if @person.present? %>
                  <small class="text-right">
                    <% if @current_user.admin? %>
                      💬 <strong><%=@person.username%><%= @person.name.present? ? " (#{@person.name})" : '' %></strong>
                    <% else %>
                      <span title="Firstaid" aria-label="Firstaid">⛑️</span> <strong>Firstaid</strong>
                    <% end %>
                    <% if @current_user.admin? %>
                      | ⏱️ <%=@person.last_updated_at.present? ? time_ago_in_words(@person.last_updated_at) : 'N/A'%>
                    <% elsif @admin_last_active.present? %>
                      | ⏱️ <%=time_ago_in_words(@admin_last_active)%>
                    <% else %>
                      | ⏱️ N/A
                    <% end %>
                  </small>
                <% end %>
                <div class="w-full max-w-xl lg:max-w-none max-h-[55vh] lg:max-h-[60vh] overflow-y-auto overflow-x-hidden px-1" id="message-container">
                  <% @messages.each do |msg| %>
                    <% mine = msg.user_id == @current_user.id %>
                    <div class="group relative flex mt-1.5 <%= mine ? 'justify-end' : 'justify-start' %>"
                         data-msg-id="<%= msg.id %>" data-msg-mine="<%= mine %>"
                         data-msg-editable="<%= mine && msg.image.blank? %>"
                         data-action="touchstart->chats#swipeStart touchmove->chats#swipeMove touchend->chats#swipeEnd">
                      <span class="pointer-events-none absolute left-1 top-1/2 -translate-y-1/2 text-gray-400 opacity-0" data-swipe-hint>↩</span>
                       <div class="flex flex-col max-w-[78%] lg:max-w-[62%] leading-snug px-3 py-2 shadow-sm <%= mine ? 'bg-emerald-600 text-white rounded-2xl rounded-br-md' : 'bg-white text-gray-900 border border-gray-200 rounded-2xl rounded-bl-md' %>">
                          <div class="text-sm font-normal break-words <%= mine ? 'text-white' : 'text-gray-900' %>">
                            <% if msg.reply_for.present? %>
                              <span class="block mb-1 pl-2 border-l-2 text-xs <%= mine ? 'border-emerald-300 text-emerald-50' : 'border-gray-300 text-gray-500' %>">
                                ➦ <%=linkify(msg.reply_for.force_encoding('UTF-8'))%>
                              </span><br>
                            <% end %>
                            <% if msg.image.present? %>
                              <!-- Image handling -->
                              <span id="msg-content-<%= msg.id %>" class="cursor-pointer" data-lightbox-url="<%= msg.image %>" data-lightbox-type="<%= msg.image.to_s.include?(%q{/video/upload/}) ? %q{video} : %q{image} %>">
                                <svg class="w-6 h-6 <%= mine ? 'text-white' : 'text-gray-800' %>" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                  <path fill-rule="evenodd" d="M13 10a1 1 0 0 1 1-1h.01a1 1 0 1 1 0 2H14a1 1 0 0 1-1-1Z" clip-rule="evenodd"/>
                                  <path fill-rule="evenodd" d="M2 6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12c0 .556-.227 1.06-.593 1.422A.999.999 0 0 1 20.5 20H4a2.002 2.002 0 0 1-2-2V6Zm6.892 12 3.833-5.356-3.99-4.322a1 1 0 0 0-1.549.097L4 12.879V6h16v9.95l-3.257-3.619a1 1 0 0 0-1.557.088L11.2 18H8.892Z" clip-rule="evenodd"/>
                                </svg>
                              </span>
                            <% else %>
                              <% content_text = msg.content.force_encoding('UTF-8') %>
                              <span id="msg-content-<%= msg.id %>"> <%= emojify(linkify(content_text)) %> </span>
                            <% end %>

                            <span class="mt-0.5 flex items-center gap-1.5 text-[10px] <%= mine ? 'justify-end text-emerald-100' : 'text-gray-400' %>">
                              <%= msg.created_at.in_time_zone("Asia/Kolkata").strftime("%-I:%M %p") %>
                              <% if msg.edited_at.present? %>
                                <span title="Edited">· edited</span>
                              <% end %>

                              <button type="button" title="Reply" aria-label="Reply"
                                      class="ml-1 opacity-60 hover:opacity-100" 
                                      data-action="click->chats#addReply" attr-msg-id="<%= msg.id %>">↩</button>

                              <% if mine && msg.image.blank? %>
                                <button type="button" title="Edit" aria-label="Edit"
                                        class="opacity-60 hover:opacity-100"
                                        data-action="click->chats#startEdit" attr-msg-id="<%= msg.id %>">✎</button>
                              <% end %>
                            </span>

                          </div>
                       </div>
                    </div>
                  <%end%>
                </div>
              <%end%>
            </div>
          </div>
        </div>

        <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
          <a href="<%=clear_chat_path(test: "yes")%>" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
            Clear All
          </a>
          <button type="button" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto" data-action="click->chats#closeModal">Cancel </button>
        </div>
      </div>
    </div>
  </div>
</div>